{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "node"],
    "paths": { "@shared/*": ["./shared/*"], "@/*": ["./src/*"] }
  },
  "include": ["src", "shared", "tests", "vite.config.ts", "vitest.config.ts", "vitest.emu.config.ts"]
}
