{
  "name": "karneval-bestellsystem",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "functions:build": "node functions/build.mjs",
    "test:emu": "npm run functions:build && firebase emulators:exec --project demo-karneval --only auth,database,functions \"vitest run --config vitest.emu.config.ts\"",
    "emu": "npm run functions:build && firebase emulators:start --project demo-karneval --only auth,database,functions",
    "seed:dev": "node scripts/seed-dev.ts",
    "dev:emu": "vite --mode emu",
    "build:event": "node scripts/build-event.mjs",
    "migrate": "node scripts/migrate-v2.ts"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/big-shoulders-display": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "firebase": "13.0.0",
    "motion": "14.0.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "25.9.9",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "firebase-tools": "15.33.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
